<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Add MCQ Test</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: #fff;
      min-height: 100vh;
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    h1 {
      font-size: 2.5rem;
      margin-bottom: 30px;
      color: #ff9800;
      text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.3);
    }

    form {
      background-color: #fff;
      color: #1e3c72;
      border-radius: 12px;
      padding: 30px;
      max-width: 700px;
      width: 100%;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    label {
      font-weight: bold;
      margin-top: 10px;
      display: block;
    }

    input[type="text"],
    input[type="number"] {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      margin-bottom: 15px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    .question-block {
      border: 2px dashed #1e3c72;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 25px;
      background-color: #f9f9f9;
    }

    .question-block h3 {
      color: #ff9800;
    }

    button {
      padding: 10px 20px;
      font-size: 1rem;
      margin-top: 10px;
      margin-right: 10px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.3s ease;
    }

    button[type="button"] {
      background-color: #03a9f4;
      color: #fff;
    }

    button[type="button"]:hover {
      background-color: #0288d1;
    }

    button[type="submit"] {
      background-color: #4caf50;
      color: #fff;
    }

    button[type="submit"]:hover {
      background-color: #388e3c;
    }

    hr {
      border: none;
      border-top: 1px solid #ddd;
      margin-top: 20px;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 2rem;
      }

      form {
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <h1>Add New MCQ Test</h1>
  <form action="/mcqTest/add" method="POST">
    <label for="testName">Test Name:</label>
    <input type="text" name="testName" required>

    <div id="questions-container">
      <!-- Questions will be inserted here by JS -->
    </div>

    <button type="button" onclick="addQuestion()">Add Question</button>
    <button type="submit">Submit Test</button>
  </form>

  <script>
    function addQuestion() {
      const container = document.getElementById('questions-container');
      const index = container.children.length;

      const questionHTML = `
        <div class="question-block">
          <h3>Question ${index + 1}</h3>
          <input type="text" name="questions[${index}][questionText]" placeholder="Enter question text" required>
          <br>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 1" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 2" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 3" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 4" required>
          <br>
          <label>Correct Answer (0-3):</label>
          <input type="number" name="questions[${index}][correctAnswer]" min="0" max="3" required>
          <hr>
        </div>
      `;

      container.insertAdjacentHTML('beforeend', questionHTML);
    }
  </script>
</body>
</html>
