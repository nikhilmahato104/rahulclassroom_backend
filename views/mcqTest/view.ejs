<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>View MCQ Tests</title>
  <link rel="stylesheet" href="/styles/mcqtest.css">

  <style>
    body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #1e3c72, #2a5298);
  color: #fff;
  padding: 20px;
  min-height: 100vh;
}

h1 {
  text-align: center;
  font-size: 3.5rem;
  margin-bottom: 30px;
  color: #ff9800;
  text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.3);
}

table {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
  border-collapse: collapse;
  background-color: #ffffff;
  color: #1e3c72;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 0 15px rgba(0,0,0,0.2);
}

th, td {
  padding: 15px;
  text-align: left;
  border-bottom: 1px solid #ddd;
}

th {
  background-color: #1e3c72;
  color: #fff;
  font-weight: bold;
}

tr:hover {
  background-color: #f1f1f1;
}

button {
  padding: 8px 16px;
  background-color: #d32f2f;
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background-color: #b71c1c;
}

@media (max-width: 600px) {
  table, thead, tbody, th, td, tr {
    display: block;
  }

  thead tr {
    display: none;
  }

  tr {
    margin-bottom: 15px;
    background-color: #fff;
    border-radius: 10px;
    padding: 10px;
  }

  td {
    text-align: right;
    padding-left: 50%;
    position: relative;
  }

  td::before {
    content: attr(data-label);
    position: absolute;
    left: 15px;
    width: 45%;
    padding-left: 10px;
    font-weight: bold;
    color: #1e3c72;
    text-align: left;
  }
}

  </style>
</head>
<body>
  <h1>All MCQ Tests</h1>
  <table>
    <thead>
      <tr>
        <th>Test Name</th>
        <th>Number of Questions</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% tests.forEach(test => { %>
        <tr>
          <td><%= test.testName %></td>
          <td><%= test.questions.length %></td>
          <td>
            <form action="/mcqTest/delete/<%= test._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this test?');">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
