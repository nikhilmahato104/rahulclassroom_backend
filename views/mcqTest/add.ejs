<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Add MCQ Test</title>
  <link rel="stylesheet" href="/styles/mcqtest.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: #fff;
      min-height: 100vh;
      padding: 30px 20px;
    }

    h1 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 30px;
      color: #ff9800;
      text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.3);
    }

    form {
      background: #ffffff;
      color: #1e3c72;
      padding: 25px;
      border-radius: 12px;
      max-width: 800px;
      margin: 0 auto;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.25);
    }

    label {
      display: block;
      font-weight: bold;
      margin-top: 15px;
      margin-bottom: 5px;
    }

    input[type="text"],
    input[type="number"] {
      width: 100%;
      padding: 10px;
      margin-bottom: 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    .question-block {
      margin-top: 20px;
      padding: 15px;
      border: 2px dashed #ccc;
      border-radius: 8px;
      background-color: #f9f9f9;
    }

    button {
      padding: 12px 20px;
      background-color: #1e3c72;
      color: #fff;
      font-weight: bold;
      font-size: 1rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-right: 10px;
      margin-top: 20px;
    }

    button:hover {
      background-color: #16315e;
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 2rem;
      }

      form {
        padding: 15px;
      }

      button {
        width: 100%;
        margin-bottom: 10px;
      }
    }
  </style>
  
</head>
<body>
  <h1>Add New MCQ Test</h1>
  <form action="/mcqTest/add" method="POST">
    <label for="testName">Test Name:</label>
    <input type="text" name="testName" required>

    <div id="questions-container">
      <!-- Questions will be inserted here by JS -->
    </div>

    <button type="button" onclick="addQuestion()">Add Question</button>
    <button type="submit">Submit Test SetUp</button>
  </form>

  <script>
    function addQuestion() {
      const container = document.getElementById('questions-container');
      const index = container.children.length;

      const questionHTML = `
        <div class="question-block">
          <h3>Question ${index + 1}</h3>
          <input type="text" name="questions[${index}][questionText]" placeholder="Enter question text" required>
          <br>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 1" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 2" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 3" required>
          <input type="text" name="questions[${index}][options][]" placeholder="Option 4" required>
          <br>
          <label>Correct Answer (0-3):</label>
          <input type="number" name="questions[${index}][correctOption]" min="0" max="3" required>
          <hr>
        </div>
      `;
      container.insertAdjacentHTML('beforeend', questionHTML);
    }
  </script>
</body>
</html>
