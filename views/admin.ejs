<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(to right, #1e3c72, #2a5298); /* Blue Gradient */
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 20px;
    }

    h1 {
      font-size: 2.8rem;
      margin-bottom: 40px;
      color: #ff8c00; /* Orange */
      text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
    }

    .link-container {
      display: flex;
      flex-direction: column;
      gap: 15px;
      width: 100%;
      max-width: 320px;
    }

    a {
      display: block;
      background-color: #ff8c00; /* Orange */
      color: #fff;
      padding: 12px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: bold;
      font-size: 1.1rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }

    a:hover {
      background-color: #ffa733;
      transform: translateY(-3px);
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 2.2rem;
      }

      a {
        font-size: 1rem;
        padding: 10px;
      }
    }
  </style>
</head>
<body>
  <h1>Admin Panel</h1>
  <div class="link-container">
    <a href="/class8">Class 8 Operations</a>
    <a href="/class9">Class 9 Operations</a>
    <a href="/class10">Class 10 Operations</a>
  </div>
</body>
</html>
