<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MCQ Test Operations</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 20px;
    }

    h1 {
      font-size: 2.8rem;
      margin-bottom: 40px;
      color: #ff9800;
      text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.2);
    }

    .link-container {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
      max-width: 300px;
    }

    a {
      display: block;
      background-color: #ffffff;
      color: #1e3c72;
      padding: 12px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: bold;
      font-size: 1.1rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
    }

    a:hover {
      background-color: #f0f0f0;
      transform: translateY(-3px);
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 2.2rem;
      }

      a {
        font-size: 1rem;
        padding: 10px;
      }
    }
  </style>
</head>
<body>
  <h1>MCQ Test Operations</h1>
  <div class="link-container">
    <a href="/mcqTest/add">Add New Test</a>
    <a href="/mcqTest/view">View All Tests</a>
    <a href="/viewresult">View Student Results</a> <!-- ✅ New Button -->
  </div>
</body>
</html>
